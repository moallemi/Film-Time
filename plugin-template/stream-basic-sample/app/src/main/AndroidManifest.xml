<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <!-- Plugin discovery service -->
        <service
            android:name=".PluginDiscoveryService"
            android:exported="true">
            <intent-filter>
                <action android:name="io.filmtime.plugin.STREAM_PROVIDER" />
            </intent-filter>
        </service>

        <!-- Content provider for metadata + streams -->
        <provider
            android:name=".BasicPluginProvider"
            android:authorities="io.filmtime.plugin.basic"
            android:exported="true" />

    </application>

</manifest>
